{
  "name": "laravel-vue-electron",
  "version": "1.0.0",
  "main": "main.js",
  "private": true,

  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },

  "devDependencies": {
    "electron": "^40.1.0",
    "electron-builder": "^26.4.0"
  },

  "build": {
    "appId": "com.shahzaib.shop",
    "productName": "Shahzaib Shop Software",

    "directories": {
      "output": "../dist"
    },
     "extraResources": [
    {
      "from": "../php",
      "to": "php"
    },
    {
      "from": "../",
      "to": "app",
    "filter": [
      "**/*",
      "!electron/**/*",
      "!dist/**/*",
      "!node_modules/**/*",
      "!php/**/*"
    ]
    }
  ],

    "files": [
      "../app/**/*",
      "../bootstrap/**/*",
      "../config/**/*",
      "../database/**/*",
      "../public/**/*",
      "../resources/**/*",
      "../routes/**/*",
      "../vendor/**/*",
      "../artisan",
      "./**/*",
      "../php/**/*"
    ],
    "asarUnpack": [
  "php/**",
  "public/**"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
